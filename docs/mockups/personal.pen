                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "izX7q",
                  "name": "Role",
                  "fill": "#78a7ff",
                  "textGrowth": "fixed-width-height",
                  "width": 318,
                  "height": 40,
                  "content": "Senior Product Engineer (Ruby on Rails)",
                  "lineHeight": 1.55,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "S7h5AB",
                  "name": "Context",
                  "fill": "#a7b0bf",
                  "textGrowth": "fixed-width-height",
                  "width": 318,
                  "height": 56,
                  "content": "Provides Service Relationship Management software for commercial-vehicle maintenance and repair.",
                  "lineHeight": 1.33,
                  "fontFamily": "Geist Mono",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "zd537",
                  "name": "Summary",
                  "fill": "#f5f7fa",
                  "textGrowth": "fixed-width-height",
                  "width": 318,
                  "height": 90,
                  "content": "Builds role-based workflows across Ruby on Rails and Hotwire Native, expanded Action Cable messaging, and implemented recurring Stripe billing with customizable per-student plans.",
                  "lineHeight": 1.55,
                  "fontFamily": "Inter",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
