{
  "name": "smarquez1-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open --port 3000",
    "lint": "npm run lint:js && npm run lint:html && npm run lint:md",
    "lint:js": "eslint .",
    "lint:html": "npm run build && html-validate dist/index.html",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\"",
    "quality:browser": "node scripts/quality-check.mjs",
    "quality:lighthouse": "lhci autorun",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.33.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.1.11",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "html-validate": "^11.6.2",
    "markdownlint-cli2": "^0.18.1",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.11",
    "vite": "^8.1.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  }
}
